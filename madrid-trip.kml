        <styleUrl>#s-darkgreen</styleUrl>
        <Point><coordinates>-3.6894,40.4198,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>⚽ Plaza de Cibeles — World Cup Final outdoor screen</name>
