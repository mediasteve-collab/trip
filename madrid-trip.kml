        <Point><coordinates>-3.6985,40.4073,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>La Casa Encendida</name>
        <description>Fri · free contemporary art + cinema · Ronda de Valencia 2, Lavapiés</description>
        <styleUrl>#s-purple</styleUrl>
        <Point><coordinates>-3.6999,40.4060,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Cervecería La Paloma 85</name>
        <description>Fri &amp; Sun aperitivo · Calle Toledo 85, La Latina · neighbourhood bar</description>
        <styleUrl>#s-blue</styleUrl>
        <Point><coordinates>-3.7080,40.4141,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Cava Baja tapas crawl</name>
        <description>Fri 9:30pm · La Latina · Casa Revuelta · Casa Lucas · Taberna Tempranillo · La Txakolina · Lamiak · Almendro 13 · Txirimiri</description>
        <styleUrl>#s-blue</styleUrl>
        <Point><coordinates>-3.7095,40.4136,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>TRAMO (dinner alternative)</name>
        <description>Fri dinner alt · C. de Eugenio Salazar 56, Chamartín · modern Spanish tasting menu</description>
        <styleUrl>#s-blue</styleUrl>
        <Point><coordinates>-3.6821,40.4583,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Harrison 1933</name>
        <description>Fri 1am · Recoletos 16 · late-night jazz bar · ⭐ recommended · until 5:30am</description>
        <styleUrl>#s-purple</styleUrl>
        <Point><coordinates>-3.6898,40.4216,0</coordinates></Point>
      </Placemark>
