        <description>Sun pre-match drinks · Paseo de Recoletos 18 · grand terrace bar</description>
        <styleUrl>#s-blue</styleUrl>
        <Point><coordinates>-3.6923,40.4218,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>⭐ Cervecería Alemana (pre-match)</name>
