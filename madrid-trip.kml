    <!-- ════════════════════════════════════════ -->
    <!-- HOTELS                                   -->
    <!-- ════════════════════════════════════════ -->
    <Folder>
      <name>Hotels</name>
      <Placemark>
        <name>Catalonia Plaza España</name>
        <description>Stuart &amp; Josianne · Gran Vía 70</description>
        <styleUrl>#s-hotel-blue</styleUrl>
        <Point><coordinates>-3.7115,40.4203,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>JW Marriott</name>
        <description>Steve &amp; Parin · Calle Sevilla 2</description>
        <styleUrl>#s-hotel-orange</styleUrl>
        <Point><coordinates>-3.7001,40.4168,0</coordinates></Point>
      </Placemark>
    </Folder>

    <!-- ════════════════════════════════════════ -->
    <!-- THURSDAY · Jul 3                         -->
    <!-- ════════════════════════════════════════ -->
    <Folder>
      <name>Thursday · Jul 3</name>
      <Placemark>
        <name>Toma Café</name>
        <description>Thu 9am · C. de la Palma 18 · Malasaña specialty coffee</description>
        <styleUrl>#s-green</styleUrl>
        <Point><coordinates>-3.7033,40.4213,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Malasaña &amp; Chueca wander</name>
        <description>Thu 10:30am · Carapazona + In-Verso Libros · bookshops and neighbourhood streets</description>
        <styleUrl>#s-green</styleUrl>
        <Point><coordinates>-3.6960,40.4248,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Bocado</name>
        <description>Thu lunch · Santa Teresa 1 · all-day brunch spot</description>
        <styleUrl>#s-blue</styleUrl>
        <Point><coordinates>-3.6969,40.4199,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Calle de las Huertas</name>
        <description>Thu 3pm · literary stroll through Barrio Letras</description>
        <styleUrl>#s-green</styleUrl>
        <Point><coordinates>-3.6975,40.4155,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Museo Reina Sofía</name>
        <description>Thu 6:30pm · Guernica + Dalí · free 7–9pm · closed Tue · Ronda de Atocha 2</description>
        <styleUrl>#s-purple</styleUrl>
        <Point><coordinates>-3.6946,40.4079,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Le Tavernier</name>
        <description>Thu 7pm · walk-in only · Floor 8 · rooftop terrace · Gran Vía area</description>
        <styleUrl>#s-blue</styleUrl>
        <Point><coordinates>-3.7022,40.4196,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Quispe Madrid</name>
        <description>Thu 8:30pm · booked · Salón de fondo · Peruvian fine dining · Jorge Juan 33</description>
        <styleUrl>#s-blue</styleUrl>
        <Point><coordinates>-3.6880,40.4215,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Ficus Bar (nightcap)</name>
        <description>Thu nightcap · Santo Tomé 8, Chueca · African-botanical cocktails · tropical jungle interior · until 2am Thu</description>
        <styleUrl>#s-purple</styleUrl>
        <Point><coordinates>-3.6950,40.4237,0</coordinates></Point>
      </Placemark>
    </Folder>

    <!-- ════════════════════════════════════════ -->
    <!-- FRIDAY · Jul 4                           -->
