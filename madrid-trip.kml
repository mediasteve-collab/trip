        <styleUrl>#s-darkgreen</styleUrl>
        <Point><coordinates>-3.6892,40.4197,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Ponja Nikkei (after match)</name>
        <description>Sun after match · Santa Teresa 16 · Nikkei (Japanese-Peruvian) · Chueca</description>
        <styleUrl>#s-purple</styleUrl>
        <Point><coordinates>-3.6969,40.4199,0</coordinates></Point>
      </Placemark>
    </Folder>

