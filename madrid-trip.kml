        <styleUrl>#s-green</styleUrl>
        <Point><coordinates>-3.7173,40.4183,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>The Hat Rooftop</name>
        <description>Sat 6pm · Imperial 9 · rooftop bar with Palacio Real views · pre-dinner drinks pick one</description>
        <styleUrl>#s-blue</styleUrl>
        <Point><coordinates>-3.7010,40.4143,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Makáa Rooftop</name>
        <description>Sat 8pm · Plaza del Carmen · pre-dinner cocktails · Gran Vía rooftop · pick one</description>
        <styleUrl>#s-blue</styleUrl>
        <Point><coordinates>-3.7028,40.4188,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>61.Sixtyone</name>
        <description>Sat 9:30pm · booked · José Abascal 61, Almagro · tasting menu restaurant</description>
        <styleUrl>#s-purple</styleUrl>
        <Point><coordinates>-3.6995,40.4383,0</coordinates></Point>
      </Placemark>
    </Folder>

